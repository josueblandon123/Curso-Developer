<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <masterLabel>PropertyFiltersChannel</masterLabel>
    <isExposed>true</isExposed>
    <description>Communication channel to send search filters to the property list.</description>
    <lightningMessageFields>
        <fieldName>searchKey</fieldName>
        <description>Search text for name or address</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>maxPrice</fieldName>
        <description>Maximum property price</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>bedrooms</fieldName>
        <description>Minimum number of rooms</description>
    </lightningMessageFields>
    <lightningMessageFields>
        <fieldName>bathrooms</fieldName>
        <description>Minimum number of bathrooms</description>
    </lightningMessageFields>
</LightningMessageChannel>